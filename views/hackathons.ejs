<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Hackathons & Innovation Sprints | SRM Academia</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-base: #06090f;
      --bg-surface: #0c121e;
      --bg-card: rgba(15, 23, 42, 0.75);
      --bg-card-hover: rgba(24, 36, 64, 0.9);
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-glow: rgba(236, 72, 153, 0.4);
      --indigo-500: #6366f1;
      --indigo-600: #4f46e5;
      --cyan-400: #38bdf8;
      --cyan-500: #0ea5e9;
      --violet-500: #8b5cf6;
      --emerald-400: #34d399;
      --amber-400: #fbbf24;
      --rose-400: #fb7185;
      --pink-500: #ec4899;
      --pink-600: #db2777;
      --text-main: #f8fafc;
      --text-sub: #cbd5e1;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-full: 9999px;
      --shadow-card: 0 12px 36px -4px rgba(0, 0, 0, 0.6), 0 0 0 1px var(--border-subtle);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-base);
      background-image: 
        radial-gradient(ellipse 90% 60% at 50% -10%, rgba(236, 72, 153, 0.22) 0%, transparent 60%),
        radial-gradient(circle at 10% 35%, rgba(56, 189, 248, 0.12) 0%, transparent 45%),
        radial-gradient(circle at 90% 65%, rgba(139, 92, 246, 0.16) 0%, transparent 50%),
        radial-gradient(circle at 50% 100%, rgba(15, 23, 42, 0.85) 0%, transparent 80%);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      line-height: 1.5;
      display: flex;
      flex-direction: column;
      padding-bottom: 110px;
    }

    /* Top Sticky Glass Navigation Header */
    .app-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(6, 9, 15, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-subtle);
      padding: 14px 32px;
    }

    .app-header-inner {
      max-width: 1440px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand-link {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }

    .brand-icon-box {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      box-shadow: 0 4px 12px rgba(236, 72, 153, 0.4);
    }

    .brand-icon-box svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .brand-text-block h1 {
      font-size: 1.05rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.01em;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-badge {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: var(--radius-full);
      background: rgba(236, 72, 153, 0.15);
      border: 1px solid rgba(236, 72, 153, 0.35);
      color: #fbcfe8;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .brand-text-block p {
      font-size: 0.72rem;
      color: var(--text-muted);
    }

    .header-nav-right {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .user-pill {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 5px 14px 5px 6px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
    }

    .avatar-circle {
      width: 28px;
      height: 28px;
      border-radius: var(--radius-full);
      background: linear-gradient(135deg, #ec4899, #8b5cf6);
      color: #fff;
      font-size: 0.75rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .user-meta-text {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }

    .user-name-text {
      font-size: 0.8rem;
      font-weight: 700;
      color: #fff;
    }

    .user-id-text {
      font-size: 0.68rem;
      color: var(--text-muted);
    }

    .menu-toggle-btn {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .menu-toggle-btn:hover {
      background: rgba(236, 72, 153, 0.2);
      border-color: var(--pink-500);
    }

    .menu-toggle-btn svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    /* Screen Canvas */
    .screen-wrapper {
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
      padding: 32px 32px 40px;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    /* Hero Banner */
    .hack-hero-banner {
      background: linear-gradient(135deg, rgba(30, 41, 59, 0.7) 0%, rgba(15, 23, 42, 0.8) 100%);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 30px 36px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 20px;
      box-shadow: var(--shadow-card);
      position: relative;
      overflow: hidden;
    }

    .hack-hero-banner::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 6px;
      height: 100%;
      background: linear-gradient(180deg, #ec4899, #8b5cf6);
    }

    .hero-titles h1 {
      font-size: 1.85rem;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin-bottom: 6px;
    }

    .gradient-text {
      background: linear-gradient(135deg, #f472b6 0%, #c084fc 50%, #38bdf8 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      display: inline-block;
    }

    .hero-titles p {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .hero-action-chips {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }

    .chip-item {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 16px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-full);
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-sub);
    }

    .chip-item svg {
      width: 16px;
      height: 16px;
      stroke: #f472b6;
      fill: none;
      stroke-width: 2;
    }

    /* 4 Metric Stats Strip */
    .metrics-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    .metric-panel {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 18px 22px;
      display: flex;
      align-items: center;
      gap: 16px;
      box-shadow: var(--shadow-card);
      backdrop-filter: blur(12px);
    }

    .metric-icon-bubble {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .metric-icon-bubble.pink {
      background: rgba(236, 72, 153, 0.15);
      color: #f472b6;
      border: 1px solid rgba(236, 72, 153, 0.3);
    }

    .metric-icon-bubble.purple {
      background: rgba(139, 92, 246, 0.15);
      color: #c084fc;
      border: 1px solid rgba(139, 92, 246, 0.3);
    }

    .metric-icon-bubble.cyan {
      background: rgba(14, 165, 233, 0.15);
      color: #38bdf8;
      border: 1px solid rgba(14, 165, 233, 0.3);
    }

    .metric-icon-bubble.emerald {
      background: rgba(52, 211, 153, 0.15);
      color: #34d399;
      border: 1px solid rgba(52, 211, 153, 0.3);
    }

    .metric-icon-bubble svg {
      width: 22px;
      height: 22px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .metric-content-box {
      display: flex;
      flex-direction: column;
    }

    .metric-main-val {
      font-size: 1.35rem;
      font-weight: 800;
      color: #ffffff;
      line-height: 1.2;
    }

    .metric-sub-title {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-weight: 600;
      margin-top: 2px;
    }

    /* Section Subhead */
    .section-headline-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 4px;
    }

    .section-headline-bar h2 {
      font-size: 1.3rem;
      font-weight: 800;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .section-count-badge {
      font-size: 0.75rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      background: rgba(236, 72, 153, 0.15);
      color: #fbcfe8;
      border: 1px solid rgba(236, 72, 153, 0.3);
    }

    /* Grid of Hackathons */
    .hackathons-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
      gap: 24px;
    }

    .hackathon-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 26px 28px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 18px;
      box-shadow: var(--shadow-card);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      transition: all 0.25s ease;
      position: relative;
    }

    .hackathon-card:hover {
      transform: translateY(-4px);
      border-color: rgba(236, 72, 153, 0.45);
      background: var(--bg-card-hover);
      box-shadow: 0 16px 40px -4px rgba(0, 0, 0, 0.7), 0 0 24px rgba(236, 72, 153, 0.25);
    }

    .card-top-tags {
      display: flex;
      align-items: center;
      gap: 8px;
      flex-wrap: wrap;
    }

    .hack-badge {
      font-size: 0.7rem;
      font-weight: 700;
      text-transform: uppercase;
      padding: 3px 10px;
      border-radius: var(--radius-full);
      letter-spacing: 0.04em;
    }

    .hack-badge.mode {
      background: rgba(14, 165, 233, 0.15);
      color: #7dd3fc;
      border: 1px solid rgba(14, 165, 233, 0.35);
    }

    .hack-badge.flagship {
      background: rgba(236, 72, 153, 0.18);
      color: #fbcfe8;
      border: 1px solid rgba(236, 72, 153, 0.4);
    }

    .card-title-section h3 {
      font-size: 1.25rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 6px;
      line-height: 1.3;
    }

    .college-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--cyan-400);
      margin-bottom: 8px;
    }

    .deadline-row {
      display: flex;
      align-items: center;
      gap: 6px;
      font-size: 0.8rem;
      color: var(--amber-400);
      font-weight: 600;
    }

    .deadline-row svg {
      width: 14px;
      height: 14px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .details-box {
      background: rgba(10, 15, 28, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: var(--radius-sm);
      padding: 14px;
      font-size: 0.85rem;
      color: var(--text-sub);
      line-height: 1.6;
      white-space: pre-wrap;
    }

    .details-box strong {
      display: block;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-dim);
      margin-bottom: 4px;
    }

    .card-footer-strip {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding-top: 14px;
      border-top: 1px solid var(--border-subtle);
    }

    .fee-badge-box {
      display: flex;
      flex-direction: column;
    }

    .fee-label {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: var(--text-dim);
    }

    .fee-amount {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--emerald-400);
    }

    .btn-register-hack {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 20px;
      background: linear-gradient(135deg, #ec4899 0%, #8b5cf6 100%);
      color: #ffffff;
      border: none;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 4px 14px rgba(236, 72, 153, 0.35);
      transition: all 0.2s ease;
      cursor: pointer;
    }

    .btn-register-hack:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(236, 72, 153, 0.5);
    }

    .btn-register-hack svg {
      width: 16px;
      height: 16px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    /* Innovation Hub Roadmap & Support Section */
    .incubation-support-card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 30px 36px;
      box-shadow: var(--shadow-card);
      backdrop-filter: blur(16px);
      display: flex;
      flex-direction: column;
      gap: 22px;
    }

    .support-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }

    .support-header-text h3 {
      font-size: 1.25rem;
      font-weight: 800;
      color: #ffffff;
      margin-bottom: 4px;
    }

    .support-header-text p {
      font-size: 0.88rem;
      color: var(--text-muted);
    }

    .perks-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .perk-tile {
      background: rgba(10, 15, 28, 0.5);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 18px 20px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .perk-tile-head {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .perk-icon-circle {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.9rem;
      background: rgba(255, 255, 255, 0.05);
    }

    .perk-tile h4 {
      font-size: 0.92rem;
      font-weight: 800;
      color: #ffffff;
    }

    .perk-tile p {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* Floating Capsule Dock */
    .capsule-dock {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 99;
      display: flex;
      align-items: center;
      gap: 6px;
      padding: 6px 8px;
      background: rgba(12, 18, 30, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius-full);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7), 0 0 20px rgba(99, 102, 241, 0.2);
    }

    .capsule-dock form {
      margin: 0;
      display: inline-block;
    }

    .dock-pill-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 9px 18px;
      background: transparent;
      border: 1px solid transparent;
      border-radius: var(--radius-full);
      color: var(--text-muted);
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      white-space: nowrap;
    }

    .dock-pill-btn svg {
      width: 17px;
      height: 17px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .dock-pill-btn:hover {
      color: var(--text-main);
      background: rgba(255, 255, 255, 0.06);
    }

    /* Slide-Over Drawer */
    .drawer-scrim {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.75);
      backdrop-filter: blur(8px);
      z-index: 1000;
      display: none;
      opacity: 0;
      transition: opacity 0.3s ease;
    }

    .drawer-scrim.open {
      display: block;
      opacity: 1;
    }

    .drawer-sheet {
      position: fixed;
      top: 0;
      right: -360px;
      width: 340px;
      height: 100%;
      background: #090e17;
      border-left: 1px solid var(--border-subtle);
      z-index: 1001;
      padding: 28px 24px;
      display: flex;
      flex-direction: column;
      gap: 24px;
      box-shadow: -10px 0 40px rgba(0, 0, 0, 0.8);
      transition: right 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      overflow-y: auto;
    }

    .drawer-scrim.open .drawer-sheet {
      right: 0;
    }

    .drawer-sheet-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border-subtle);
    }

    .drawer-sheet-title {
      font-size: 0.95rem;
      font-weight: 800;
      color: #ffffff;
    }

    .drawer-close-icon {
      background: transparent;
      border: none;
      color: var(--text-muted);
      font-size: 1.2rem;
      cursor: pointer;
      padding: 4px 8px;
      border-radius: 6px;
      transition: all 0.2s;
    }

    .drawer-close-icon:hover {
      color: #fff;
      background: rgba(255, 255, 255, 0.1);
    }

    .drawer-nav-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .drawer-nav-list form {
      margin: 0;
    }

    .drawer-nav-item {
      width: 100%;
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 12px 14px;
      border-radius: var(--radius-sm);
      background: transparent;
      border: 1px solid transparent;
      color: var(--text-sub);
      font-family: inherit;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      text-align: left;
      transition: all 0.2s ease;
    }

    .drawer-nav-item:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: var(--border-subtle);
      color: #ffffff;
      transform: translateX(4px);
    }

    .drawer-nav-item.active {
      background: rgba(236, 72, 153, 0.15);
      border-color: rgba(236, 72, 153, 0.3);
      color: #fbcfe8;
    }

    .drawer-nav-item svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
      flex-shrink: 0;
    }

    .drawer-footer-block {
      margin-top: auto;
      padding-top: 20px;
      border-top: 1px solid var(--border-subtle);
    }

    .btn-drawer-logout {
      width: 100%;
      padding: 12px;
      border-radius: var(--radius-sm);
      background: rgba(244, 63, 94, 0.12);
      border: 1px solid rgba(244, 63, 94, 0.25);
      color: var(--rose-400);
      font-size: 0.85rem;
      font-weight: 700;
      text-decoration: none;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      transition: all 0.2s;
    }

    .btn-drawer-logout:hover {
      background: rgba(244, 63, 94, 0.2);
    }

    /* Responsive */
    @media (max-width: 1024px) {
      .metrics-row {
        grid-template-columns: repeat(2, 1fr);
      }

      .perks-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      .screen-wrapper {
        padding: 20px 16px 30px;
      }

      .app-header {
        padding: 12px 16px;
      }

      .hack-hero-banner {
        padding: 22px 20px;
      }

      .metrics-row {
        grid-template-columns: 1fr;
      }

      .hackathons-grid {
        grid-template-columns: 1fr;
      }

      .capsule-dock {
        width: 92%;
        justify-content: space-around;
      }

      .dock-pill-btn span {
        display: none;
      }

      .dock-pill-btn {
        padding: 10px 14px;
      }
    }
  </style>
</head>

<body>

  <!-- Top Ambient Navigation Header -->
  <header class="app-header">
    <div class="app-header-inner">
      <a href="/student-profile?name=<%= encodeURIComponent(name || '') %>&id=<%= encodeURIComponent(id || '') %>&password=<%= encodeURIComponent(password || '') %>" class="brand-link">
        <div class="brand-icon-box">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <div class="brand-text-block">
          <h1>
            <span>SRM ACADEMIA</span>
            <span class="brand-badge">Innovation Desk</span>
          </h1>
          <p>National Engineering Sprints & Tech Grants</p>
        </div>
      </a>

      <div class="header-nav-right">
        <% if (name) { %>
          <div class="user-pill">
            <div class="avatar-circle"><%= name.charAt(0).toUpperCase() %></div>
            <div class="user-meta-text">
              <span class="user-name-text"><%= name %></span>
              <span class="user-id-text">Roll: <%= id || '1' %></span>
            </div>
          </div>
        <% } %>

        <button class="menu-toggle-btn" onclick="toggleDrawer()" title="Open Navigation Menu">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </div>
  </header>

  <!-- Screen Content Canvas -->
  <main class="screen-wrapper">

    <!-- Hero Banner -->
    <section class="hack-hero-banner">
      <div class="hero-titles">
        <h1>Flagship National <span class="gradient-text">Hackathons & Sprints</span></h1>
        <p>Collegiate engineering sprints, cash prize pools, incubation grants & direct mentorship for SRM students</p>
      </div>

      <div class="hero-action-chips">
        <div class="chip-item">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          <span>₹50,00,000+ Prize Grants</span>
        </div>
        <div class="chip-item">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span>Verified University Hosts</span>
        </div>
      </div>
    </section>

    <!-- 4 Metric Stats Strip -->
    <section class="metrics-row">
      <div class="metric-panel">
        <div class="metric-icon-bubble pink">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <div class="metric-content-box">
          <span class="metric-main-val"><%= (hackathons && hackathons.length > 0) ? hackathons.length : '3 Active' %></span>
          <span class="metric-sub-title">Flagship Sprints</span>
        </div>
      </div>

      <div class="metric-panel">
        <div class="metric-icon-bubble purple">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div class="metric-content-box">
          <span class="metric-main-val">₹ 15.5 Lakhs</span>
          <span class="metric-sub-title">Total Cash Pool</span>
        </div>
      </div>

      <div class="metric-panel">
        <div class="metric-icon-bubble cyan">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
        </div>
        <div class="metric-content-box">
          <span class="metric-main-val">45+ Colleges</span>
          <span class="metric-sub-title">Partner Institutions</span>
        </div>
      </div>

      <div class="metric-panel">
        <div class="metric-icon-bubble emerald">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        </div>
        <div class="metric-content-box">
          <span class="metric-main-val">Incubation</span>
          <span class="metric-sub-title">Direct Seed Funding</span>
        </div>
      </div>
    </section>

    <!-- Headline Bar -->
    <div class="section-headline-bar">
      <h2>
        <span>Current Collegiate Hackathons</span>
        <span class="section-count-badge">Spring 2026 Edition</span>
      </h2>
    </div>

    <!-- Live Hackathons Grid -->
    <section class="hackathons-grid">
      
      <!-- Render Database Loaded Hackathons (If any) -->
      <% if (hackathons && hackathons.length > 0) { %>
        <% hackathons.forEach(h => { %>
          <div class="hackathon-card">
            <div>
              <div class="card-top-tags">
                <span class="hack-badge mode">
                  <%= (h.mode || 'Online').charAt(0).toUpperCase() + (h.mode || 'Online').slice(1) %>
                </span>
                <span class="hack-badge flagship">Verified Hackathon</span>
              </div>

              <div class="card-title-section" style="margin-top: 14px;">
                <h3><%= h.hackathonName %></h3>
                <div class="college-row">
                  <span>🏛️ <%= h.collegeName %></span>
                </div>
                <div class="deadline-row">
                  <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <span>Deadline: <%= h.deadline %></span>
                </div>
              </div>

              <div class="details-box" style="margin-top: 14px;">
                <strong>Competition Brief</strong>
                <%= h.details && h.details.length > 180 ? h.details.substring(0, 180) + '...' : h.details %>
              </div>
            </div>

            <div class="card-footer-strip">
              <div class="fee-badge-box">
                <span class="fee-label">Entry Fee</span>
                <span class="fee-amount">₹ <%= h.fees || 'Free' %></span>
              </div>
              <a href="<%= h.link %>" target="_blank" rel="noopener noreferrer" class="btn-register-hack">
                <span>Register</span>
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            </div>
          </div>
        <% }); %>
      <% } %>

      <!-- Flagship Campus Sprints (Ensures page is ALWAYS screen-filling and stunning) -->
      <div class="hackathon-card">
        <div>
          <div class="card-top-tags">
            <span class="hack-badge flagship">SRM Flagship</span>
            <span class="hack-badge mode">In-Person • 36 Hours</span>
          </div>

          <div class="card-title-section" style="margin-top: 14px;">
            <h3>SRM HackTrek 2026</h3>
            <div class="college-row">
              <span>🏛️ SRM Institute of Science and Technology, Kattankulathur</span>
            </div>
            <div class="deadline-row">
              <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Registrations Close: May 20, 2026</span>
            </div>
          </div>

          <div class="details-box" style="margin-top: 14px;">
            <strong>Tracks & Themes</strong>
            GenAI & Autonomous Agents, Decentralized Infrastructure (Web3), Smart Cities & CleanTech, and Autonomous Robotics. Mentorship from Google, Microsoft & AWS engineers.
          </div>
        </div>

        <div class="card-footer-strip">
          <div class="fee-badge-box">
            <span class="fee-label">Prize Pool</span>
            <span class="fee-amount">₹ 5,00,000</span>
          </div>
          <button type="button" class="btn-register-hack" onclick="alert('SRM HackTrek Portal: Pre-registration link will open for SRM enrolled students on the official portal!')">
            <span>Pre-Register</span>
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </button>
        </div>
      </div>

      <div class="hackathon-card">
        <div>
          <div class="card-top-tags">
            <span class="hack-badge flagship" style="background: rgba(14, 165, 233, 0.18); color: #7dd3fc; border-color: rgba(14, 165, 233, 0.4);">National Qualifier</span>
            <span class="hack-badge mode">Hybrid Format</span>
          </div>

          <div class="card-title-section" style="margin-top: 14px;">
            <h3>Smart India Hackathon (SIH) Internal Round</h3>
            <div class="college-row">
              <span>🏛️ Ministry of Education & AICTE Innovation Cell</span>
            </div>
            <div class="deadline-row">
              <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Submissions: June 10, 2026</span>
            </div>
          </div>

          <div class="details-box" style="margin-top: 14px;">
            <strong>Problem Statements</strong>
            Solving real-world technological challenges proposed by Central Ministries, State Governments, Public Sector Undertakings (PSUs), and top Indian NGOs.
          </div>
        </div>

        <div class="card-footer-strip">
          <div class="fee-badge-box">
            <span class="fee-label">Grand Finals</span>
            <span class="fee-amount">₹ 1,00,000 / Team</span>
          </div>
          <button type="button" class="btn-register-hack" onclick="alert('Smart India Hackathon: Submit your team synopsis to your department SIH SPOC coordinator.')">
            <span>Details & SPOC</span>
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </button>
        </div>
      </div>

      <div class="hackathon-card">
        <div>
          <div class="card-top-tags">
            <span class="hack-badge flagship" style="background: rgba(52, 211, 153, 0.18); color: #6ee7b7; border-color: rgba(52, 211, 153, 0.4);">Open Innovation</span>
            <span class="hack-badge mode">Online • 48 Hours</span>
          </div>

          <div class="card-title-section" style="margin-top: 14px;">
            <h3>SRM AI Developer Challenge</h3>
            <div class="college-row">
              <span>🏛️ School of Computing, SRM IST</span>
            </div>
            <div class="deadline-row">
              <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Sprint Date: July 5 - 7, 2026</span>
            </div>
          </div>

          <div class="details-box" style="margin-top: 14px;">
            <strong>Challenge Statement</strong>
            Build production-ready full-stack applications with localized AI inference, vector databases, and real-time streaming interfaces. Free API access provided to all teams.
          </div>
        </div>

        <div class="card-footer-strip">
          <div class="fee-badge-box">
            <span class="fee-label">Cash Pool</span>
            <span class="fee-amount">₹ 2,50,000</span>
          </div>
          <button type="button" class="btn-register-hack" onclick="alert('AI Developer Challenge: Registrations opening soon. Watch this space!')">
            <span>Join Waitlist</span>
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
          </button>
        </div>
      </div>

    </section>

    <!-- Innovation & Incubation Support Perks Strip -->
    <section class="incubation-support-card">
      <div class="support-header">
        <div class="support-header-text">
          <h3>SRM Student Innovation Perks & Grants</h3>
          <p>Every team competing in external or internal hackathons gets institutional backing from the SRM Incubation Cell</p>
        </div>
      </div>

      <div class="perks-grid">
        <div class="perk-tile">
          <div class="perk-tile-head">
            <div class="perk-icon-circle">☁️</div>
            <h4>$1,000 Cloud Credits</h4>
          </div>
          <p>Complimentary AWS and Google Cloud Platform compute credits for prototyping and deploying web architectures.</p>
        </div>

        <div class="perk-tile">
          <div class="perk-tile-head">
            <div class="perk-icon-circle">📜</div>
            <h4>Duty Leave (On-Duty)</h4>
          </div>
          <p>Automated attendance regularization and academic on-duty approvals for participating teams during sprint hours.</p>
        </div>

        <div class="perk-tile">
          <div class="perk-tile-head">
            <div class="perk-icon-circle">🚀</div>
            <h4>Seed Capital & Incubation</h4>
          </div>
          <p>Winning hackathon projects get direct admission into SRM Innovation and Incubation Centre (SIIC) seed funding.</p>
        </div>
      </div>
    </section>

  </main>

  <!-- Modern Floating Executive Capsule Dock -->
  <nav class="capsule-dock">
    <form action="/student-profile" method="GET">
      <input type="hidden" name="name" value="<%= name %>">
      <input type="hidden" name="id" value="<%= id %>">
      <input type="hidden" name="password" value="<%= password %>">
      <button type="submit" class="dock-pill-btn">
        <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
        <span>Home</span>
      </button>
    </form>

    <form action="/student-dashboard" method="POST">
      <input type="hidden" name="id" value="<%= id %>">
      <input type="hidden" name="password" value="<%= password %>">
      <button type="submit" class="dock-pill-btn">
        <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
        <span>Attendance</span>
      </button>
    </form>

    <form action="/student-marks" method="POST">
      <input type="hidden" name="studentId" value="<%= id %>">
      <input type="hidden" name="password" value="<%= password %>">
      <button type="submit" class="dock-pill-btn">
        <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
        <span>Marks</span>
      </button>
    </form>

    <form action="/view-timetable" method="POST">
      <input type="hidden" name="studentName" value="<%= name %>">
      <input type="hidden" name="id" value="<%= id %>">
      <input type="hidden" name="password" value="<%= password %>">
      <button type="submit" class="dock-pill-btn">
        <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <span>Timetable</span>
      </button>
    </form>
  </nav>

  <!-- Slide-Over Navigation Drawer -->
  <div class="drawer-scrim" id="drawerScrim" onclick="toggleDrawer()">
    <div class="drawer-sheet" onclick="event.stopPropagation()">
      <div class="drawer-sheet-top">
        <span class="drawer-sheet-title">SRM Academia Navigation</span>
        <button class="drawer-close-icon" onclick="toggleDrawer()">✕</button>
      </div>

      <div class="drawer-nav-list">
        <form action="/student-info" method="POST">
          <input type="hidden" name="id" value="<%= id %>">
          <input type="hidden" name="name" value="<%= name %>">
          <input type="hidden" name="password" value="<%= password %>">
          <button type="submit" class="drawer-nav-item">
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            <span>My Student Profile</span>
          </button>
        </form>

        <form action="/student-dashboard" method="POST">
          <input type="hidden" name="id" value="<%= id %>">
          <input type="hidden" name="password" value="<%= password %>">
          <button type="submit" class="drawer-nav-item">
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
            <span>Attendance Portal</span>
          </button>
        </form>

        <form action="/student-marks" method="POST">
          <input type="hidden" name="studentId" value="<%= id %>">
          <input type="hidden" name="password" value="<%= password %>">
          <button type="submit" class="drawer-nav-item">
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            <span>Marks & Scorecard</span>
          </button>
        </form>

        <form action="/view-timetable" method="POST">
          <input type="hidden" name="studentName" value="<%= name %>">
          <input type="hidden" name="id" value="<%= id %>">
          <input type="hidden" name="password" value="<%= password %>">
          <button type="submit" class="drawer-nav-item">
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>Lecture Timetable</span>
          </button>
        </form>

        <form action="/view-internships" method="GET">
          <input type="hidden" name="name" value="<%= name %>">
          <input type="hidden" name="id" value="<%= id %>">
          <input type="hidden" name="password" value="<%= password %>">
          <button type="submit" class="drawer-nav-item">
            <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>Internship Hub</span>
          </button>
        </form>

        <a href="/view-hackathons?name=<%= encodeURIComponent(name || '') %>&id=<%= encodeURIComponent(id || '') %>&password=<%= encodeURIComponent(password || '') %>" class="drawer-nav-item active">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
          <span>Hackathons Hub</span>
        </a>

        <a href="chat.html" class="drawer-nav-item">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"/></svg>
          <span>SRM GPT (AI Chat)</span>
        </a>
      </div>

      <div class="drawer-footer-block">
        <a href="/login.html" class="btn-drawer-logout">
          <svg viewBox="0 0 24 24" style="width: 16px; height: 16px; stroke: currentColor; fill: none; stroke-width: 2;"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
          <span>Sign Out</span>
        </a>
      </div>
    </div>
  </div>

  <script>
    function toggleDrawer() {
      const scrim = document.getElementById('drawerScrim');
      scrim.classList.toggle('open');
    }
  </script>

</body>
</html>
