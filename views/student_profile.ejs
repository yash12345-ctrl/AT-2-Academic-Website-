<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= name %> | Academic Portal & Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-base: #06090f;
      --bg-surface: #0c121e;
      --bg-card: rgba(15, 23, 42, 0.7);
      --bg-card-hover: rgba(24, 36, 64, 0.85);
      --border-subtle: rgba(255, 255, 255, 0.07);
      --border-hover: rgba(99, 102, 241, 0.45);
      
      --indigo-500: #6366f1;
      --indigo-600: #4f46e5;
      --cyan-400: #38bdf8;
      --cyan-500: #0ea5e9;
      --violet-500: #8b5cf6;
      --emerald-400: #34d399;
      --amber-400: #fbbf24;
      --rose-400: #fb7185;

      --text-main: #f8fafc;
      --text-sub: #cbd5e1;
      --text-muted: #94a3b8;
      --text-dim: #64748b;

      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-pill: 9999px;

      --shadow-subtle: 0 4px 20px -2px rgba(0, 0, 0, 0.4);
      --shadow-card: 0 12px 36px -4px rgba(0, 0, 0, 0.55), 0 0 0 1px var(--border-subtle);
      --shadow-glow: 0 0 30px -5px rgba(99, 102, 241, 0.25);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html, body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-base);
      background-image: 
        radial-gradient(ellipse 90% 50% at 50% -10%, rgba(99, 102, 241, 0.25) 0%, transparent 60%),
        radial-gradient(circle at 5% 30%, rgba(56, 189, 248, 0.12) 0%, transparent 45%),
        radial-gradient(circle at 95% 65%, rgba(139, 92, 246, 0.14) 0%, transparent 50%),
        radial-gradient(ellipse 70% 40% at 50% 100%, rgba(15, 23, 42, 0.9) 0%, transparent 80%);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      line-height: 1.5;
      padding-bottom: 110px;
    }

    /* Top Navigation Header */
    .app-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(6, 9, 15, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-subtle);
      padding: 14px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand-group {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
    }

    .brand-logo-img {
      height: 40px;
      width: auto;
      object-fit: contain;
      filter: drop-shadow(0 0 10px rgba(99, 102, 241, 0.5));
    }

    .brand-titles {
      display: flex;
      flex-direction: column;
    }

    .brand-title-main {
      font-size: 1.05rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.02em;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .brand-badge {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: var(--radius-pill);
      background: rgba(99, 102, 241, 0.15);
      border: 1px solid rgba(99, 102, 241, 0.35);
      color: #c7d2fe;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .brand-title-sub {
      font-size: 0.72rem;
      color: var(--text-muted);
      font-weight: 500;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .day-order-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 14px;
      border-radius: var(--radius-pill);
      background: rgba(56, 189, 248, 0.1);
      border: 1px solid rgba(56, 189, 248, 0.25);
      color: var(--cyan-400);
      font-size: 0.78rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .day-order-chip span.dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      background: var(--cyan-400);
      box-shadow: 0 0 8px var(--cyan-400);
    }

    .user-pill {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 5px 14px 5px 6px;
      border-radius: var(--radius-pill);
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
    }

    .avatar-circle {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--indigo-500) 0%, var(--cyan-400) 100%);
      color: #ffffff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.85rem;
      font-weight: 800;
      box-shadow: 0 2px 10px rgba(99, 102, 241, 0.4);
    }

    .user-meta-text {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }

    .user-name-text {
      font-size: 0.82rem;
      font-weight: 700;
      color: #ffffff;
    }

    .user-id-text {
      font-size: 0.7rem;
      color: var(--text-muted);
    }

    .menu-toggle-btn {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .menu-toggle-btn:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .menu-toggle-btn svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    /* Main Dashboard Layout */
    .dashboard-container {
      max-width: 1240px;
      margin: 0 auto;
      padding: 30px 24px 60px;
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    /* Welcome Hero Card */
    .hero-banner {
      background: linear-gradient(135deg, rgba(20, 29, 48, 0.85) 0%, rgba(12, 18, 30, 0.95) 100%);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 28px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-card);
    }

    .hero-banner::before {
      content: "";
      position: absolute;
      top: -60px;
      right: -40px;
      width: 260px;
      height: 260px;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-text-group h1 {
      font-size: clamp(1.4rem, 2.5vw, 1.95rem);
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.025em;
    }

    .hero-text-group h1 span.gradient-name {
      background: linear-gradient(135deg, #a5b4fc 0%, #38bdf8 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .hero-text-group p {
      font-size: 0.88rem;
      color: var(--text-muted);
      margin-top: 5px;
    }

    .hero-badges-row {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .hero-stat-pill {
      display: flex;
      align-items: center;
      gap: 8px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 8px 16px;
      font-size: 0.82rem;
      font-weight: 700;
      color: #e2e8f0;
    }

    .hero-stat-pill svg {
      width: 16px;
      height: 16px;
      color: var(--cyan-400);
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    @media (max-width: 768px) {
      .hero-banner {
        flex-direction: column;
        align-items: flex-start;
        gap: 18px;
        padding: 22px;
      }
    }

    /* Metric Summary Strip (4 Cards) */
    .metrics-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }

    @media (max-width: 980px) {
      .metrics-strip {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    @media (max-width: 520px) {
      .metrics-strip {
        grid-template-columns: 1fr;
      }
    }

    .metric-card {
      background: var(--bg-card);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 18px 20px;
      display: flex;
      align-items: center;
      gap: 14px;
      box-shadow: var(--shadow-card);
      transition: all 0.2s ease;
    }

    .metric-card:hover {
      border-color: var(--border-hover);
      transform: translateY(-2px);
    }

    .metric-icon-box {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
      flex-shrink: 0;
    }

    .metric-icon-box.indigo { background: linear-gradient(135deg, rgba(99, 102, 241, 0.3) 0%, rgba(79, 70, 229, 0.4) 100%); border: 1px solid rgba(99, 102, 241, 0.4); color: #a5b4fc; }
    .metric-icon-box.cyan { background: linear-gradient(135deg, rgba(14, 165, 233, 0.3) 0%, rgba(2, 132, 199, 0.4) 100%); border: 1px solid rgba(14, 165, 233, 0.4); color: #7dd3fc; }
    .metric-icon-box.emerald { background: linear-gradient(135deg, rgba(16, 185, 129, 0.3) 0%, rgba(5, 150, 105, 0.4) 100%); border: 1px solid rgba(16, 185, 129, 0.4); color: #6ee7b7; }
    .metric-icon-box.amber { background: linear-gradient(135deg, rgba(245, 158, 11, 0.3) 0%, rgba(217, 119, 6, 0.4) 100%); border: 1px solid rgba(245, 158, 11, 0.4); color: #fde68a; }

    .metric-icon-box svg {
      width: 22px;
      height: 22px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .metric-text-box {
      display: flex;
      flex-direction: column;
    }

    .metric-value {
      font-size: 1.25rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.02em;
    }

    .metric-label {
      font-size: 0.74rem;
      color: var(--text-muted);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    /* 2-Column Responsive Dashboard Layout */
    .dashboard-grid {
      display: grid;
      grid-template-columns: 1.55fr 1fr;
      gap: 24px;
      align-items: start;
    }

    @media (max-width: 980px) {
      .dashboard-grid {
        grid-template-columns: 1fr;
      }
    }

    .grid-column {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    /* Executive Glass Card */
    .panel-card {
      background: var(--bg-card);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 24px;
      box-shadow: var(--shadow-card);
      position: relative;
    }

    .panel-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .panel-title-wrap {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .panel-header-icon {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-sm);
      background: rgba(99, 102, 241, 0.12);
      border: 1px solid rgba(99, 102, 241, 0.25);
      color: var(--cyan-400);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .panel-header-icon svg {
      width: 19px;
      height: 19px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .panel-title-text h2 {
      font-size: 1.05rem;
      font-weight: 700;
      color: #ffffff;
      letter-spacing: -0.01em;
    }

    .panel-title-text p {
      font-size: 0.74rem;
      color: var(--text-muted);
    }

    /* Quick App Grid Tiles */
    .apps-tiles-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }

    @media (max-width: 640px) {
      .apps-tiles-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .app-tile {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 16px 12px;
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 10px;
      color: var(--text-main);
      cursor: pointer;
      font-family: inherit;
      width: 100%;
      text-decoration: none;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .app-tile:hover {
      background: rgba(99, 102, 241, 0.12);
      border-color: rgba(99, 102, 241, 0.4);
      transform: translateY(-2px);
      box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    }

    .tile-badge-icon {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
    }

    .tile-badge-icon.t-indigo { background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%); }
    .tile-badge-icon.t-emerald { background: linear-gradient(135deg, #059669 0%, #10b981 100%); }
    .tile-badge-icon.t-amber { background: linear-gradient(135deg, #d97706 0%, #f59e0b 100%); }
    .tile-badge-icon.t-purple { background: linear-gradient(135deg, #7c3aed 0%, #a855f7 100%); }
    .tile-badge-icon.t-rose { background: linear-gradient(135deg, #e11d48 0%, #f43f5e 100%); }
    .tile-badge-icon.t-cyan { background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%); }

    .tile-badge-icon svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .tile-title {
      font-size: 0.85rem;
      font-weight: 700;
      color: #ffffff;
    }

    .tile-subtitle {
      font-size: 0.7rem;
      color: var(--text-muted);
    }

    /* Gallery Spotlight Frame */
    .gallery-showcase-frame {
      border-radius: var(--radius-md);
      overflow: hidden;
      background: #000000;
      position: relative;
      border: 1px solid var(--border-subtle);
      max-height: 290px;
      width: 100%;
    }

    .gallery-slide {
      display: none;
      width: 100%;
      height: 290px;
      object-fit: cover;
      object-position: center top;
      transition: opacity 0.5s ease;
    }

    .gallery-slide.active {
      display: block;
    }

    .gallery-overlay-badge {
      position: absolute;
      bottom: 14px;
      left: 14px;
      background: rgba(15, 23, 42, 0.85);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      padding: 6px 14px;
      border-radius: var(--radius-pill);
      font-size: 0.76rem;
      font-weight: 700;
      color: #ffffff;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .gallery-overlay-badge span.dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--emerald-400);
      box-shadow: 0 0 6px var(--emerald-400);
    }

    /* Schedule Timeline (Right Column) */
    .timeline-list {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .timeline-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.05);
      transition: all 0.15s ease;
    }

    .timeline-item:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(255, 255, 255, 0.1);
    }

    .timeline-time {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 0.82rem;
      font-weight: 700;
      color: #cbd5e1;
    }

    .timeline-time svg {
      width: 14px;
      height: 14px;
      color: var(--text-dim);
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .timeline-subject-badge {
      font-size: 0.82rem;
      font-weight: 700;
      padding: 3px 10px;
      border-radius: var(--radius-sm);
      background: rgba(99, 102, 241, 0.15);
      border: 1px solid rgba(99, 102, 241, 0.3);
      color: #c7d2fe;
    }

    .timeline-subject-badge.free {
      background: rgba(255, 255, 255, 0.03);
      border-color: transparent;
      color: var(--text-dim);
      font-weight: 500;
      font-style: italic;
    }

    /* Career Opportunities Dual Cards */
    .career-card {
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
      text-align: left;
    }

    .career-tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .career-tag-pill {
      font-size: 0.68rem;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: var(--radius-pill);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    .career-tag-pill.badge-pink {
      background: rgba(244, 63, 94, 0.12);
      border: 1px solid rgba(244, 63, 94, 0.3);
      color: #fda4af;
    }

    .career-tag-pill.badge-cyan {
      background: rgba(14, 165, 233, 0.12);
      border: 1px solid rgba(14, 165, 233, 0.3);
      color: #7dd3fc;
    }

    .career-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #ffffff;
    }

    .career-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .career-meta-item {
      display: flex;
      align-items: center;
      gap: 5px;
    }

    .career-meta-item svg {
      width: 14px;
      height: 14px;
      color: var(--text-dim);
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .career-desc {
      font-size: 0.82rem;
      color: #94a3b8;
      line-height: 1.5;
    }

    .career-actions {
      display: flex;
      gap: 10px;
      margin-top: 4px;
      flex-wrap: wrap;
    }

    .btn-career-primary {
      flex: 1;
      min-width: 130px;
      background: linear-gradient(135deg, var(--indigo-600) 0%, #3b82f6 100%);
      color: #ffffff;
      border: none;
      padding: 9px 14px;
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
      text-align: center;
      text-decoration: none;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.2s ease;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
    }

    .btn-career-primary:hover {
      background: linear-gradient(135deg, #4338ca 0%, #2563eb 100%);
      transform: translateY(-1px);
    }

    .btn-career-sub {
      flex: 1;
      min-width: 110px;
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 9px 14px;
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.82rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: all 0.2s ease;
    }

    .btn-career-sub:hover {
      background: rgba(255, 255, 255, 0.1);
      border-color: rgba(255, 255, 255, 0.2);
    }

    /* Floating Executive Capsule Dock */
    .capsule-dock {
      position: fixed;
      bottom: 22px;
      left: 50%;
      transform: translateX(-50%);
      z-index: 999;
      background: rgba(12, 18, 30, 0.9);
      backdrop-filter: blur(24px);
      -webkit-backdrop-filter: blur(24px);
      border: 1px solid rgba(255, 255, 255, 0.14);
      border-radius: var(--radius-pill);
      padding: 6px 12px;
      display: flex;
      align-items: center;
      gap: 6px;
      box-shadow: 0 16px 48px -4px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.05);
      max-width: 92vw;
    }

    .capsule-dock form {
      margin: 0;
      padding: 0;
    }

    .dock-pill-btn {
      background: transparent;
      border: none;
      color: var(--text-muted);
      padding: 9px 18px;
      border-radius: var(--radius-pill);
      font-family: inherit;
      font-size: 0.82rem;
      font-weight: 700;
      display: flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      white-space: nowrap;
    }

    .dock-pill-btn svg {
      width: 17px;
      height: 17px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .dock-pill-btn:hover {
      color: #ffffff;
      background: rgba(255, 255, 255, 0.08);
      transform: translateY(-2px);
    }

    .dock-pill-btn.active {
      color: #ffffff;
      background: linear-gradient(135deg, var(--indigo-600) 0%, #3b82f6 100%);
      box-shadow: 0 4px 14px rgba(79, 70, 229, 0.45);
    }

    /* Side-Over Navigation Drawer */
    .drawer-scrim {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.65);
      backdrop-filter: blur(8px);
      z-index: 1000;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.3s ease;
    }

    .drawer-scrim.open {
      opacity: 1;
      pointer-events: auto;
    }

    .drawer-sheet {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 340px;
      max-width: 85vw;
      background: rgba(12, 18, 30, 0.98);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border-left: 1px solid var(--border-subtle);
      z-index: 1001;
      padding: 28px 24px;
      display: flex;
      flex-direction: column;
      gap: 20px;
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      overflow-y: auto;
    }

    .drawer-scrim.open .drawer-sheet {
      transform: translateX(0);
    }

    .drawer-sheet-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      padding-bottom: 16px;
    }

    .drawer-sheet-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: #ffffff;
    }

    .drawer-close-icon {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      width: 32px;
      height: 32px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 1rem;
    }

    .drawer-nav-list {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .drawer-nav-item {
      width: 100%;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.06);
      color: var(--text-main);
      padding: 12px 14px;
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      transition: all 0.15s ease;
    }

    .drawer-nav-item:hover {
      background: rgba(99, 102, 241, 0.15);
      border-color: rgba(99, 102, 241, 0.35);
      color: #c7d2fe;
    }

    .drawer-nav-item svg {
      width: 18px;
      height: 18px;
      color: var(--cyan-400);
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }
  </style>
</head>
<body>
  <% 
    const safeTodaySubjects = (typeof todaySubjects !== 'undefined' && todaySubjects) ? todaySubjects : [];
    const safeDayOrder = (typeof dayOrder !== 'undefined' && dayOrder) ? dayOrder : 'Day 3';
    const safeInternships = (typeof internships !== 'undefined' && internships) ? internships : [];
    const safeHackathons = (typeof hackathons !== 'undefined' && hackathons) ? hackathons : [];
    const safeImages = (typeof images !== 'undefined' && images) ? images : [];
  %>

  <!-- Top Navigation Header -->
  <header class="app-header">
    <a href="/" class="brand-group">
      <img src="/images/502b3566-d983-4c87-a7ee-456acf436832_removalai_preview.png" alt="AT² Logo" class="brand-logo-img" />
      <div class="brand-titles">
        <div class="brand-title-main">
          <span>SRM ACADEMIA</span>
          <span class="brand-badge">Spring 2026</span>
        </div>
        <span class="brand-title-sub">Academic Affairs & Student Portal</span>
      </div>
    </a>

    <div class="header-actions">
      <!-- Day Order Chip -->
      <div class="day-order-chip">
        <span class="dot"></span>
        <span>Day Order: <%= safeDayOrder %></span>
      </div>

      <!-- User Identity Pill -->
      <div class="user-pill">
        <div class="avatar-circle"><%= (name && name.length > 0) ? name.charAt(0).toUpperCase() : 'S' %></div>
        <div class="user-meta-text">
          <span class="user-name-text"><%= name %></span>
          <span class="user-id-text">ID: <%= id %></span>
        </div>
      </div>

      <!-- Menu Toggle -->
      <button class="menu-toggle-btn" onclick="toggleDrawer()" title="Open Navigation Menu">
        <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </header>

  <!-- Main Dashboard Layout -->
  <main class="dashboard-container">

    <!-- Welcome Hero Banner -->
    <section class="hero-banner">
      <div class="hero-text-group">
        <h1>Welcome back, <span class="gradient-name"><%= name %></span></h1>
        <p>Spring Academic Term 2026 • Verified Enrollment & Active Timetable</p>
      </div>
      <div class="hero-badges-row">
        <div class="hero-stat-pill">
          <!-- ID Card SVG -->
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/></svg>
          <span>Roll No: <%= id %></span>
        </div>
        <div class="hero-stat-pill">
          <!-- Calendar Check SVG -->
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          <span><%= safeTodaySubjects.filter(s => s && s.subject && s.subject !== "No Class").length %> Classes Scheduled</span>
        </div>
      </div>
    </section>

    <!-- Key Metrics Summary Strip -->
    <section class="metrics-strip">
      <div class="metric-card">
        <div class="metric-icon-box indigo">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div class="metric-text-box">
          <span class="metric-value"><%= safeDayOrder %></span>
          <span class="metric-label">Active Day Order</span>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-icon-box cyan">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
        </div>
        <div class="metric-text-box">
          <span class="metric-value"><%= safeTodaySubjects.filter(s => s && s.subject && s.subject !== "No Class").length %> Slots</span>
          <span class="metric-label">Today's Lectures</span>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-icon-box emerald">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        </div>
        <div class="metric-text-box">
          <span class="metric-value"><%= safeInternships.length %> Opportunities</span>
          <span class="metric-label">Campus Internships</span>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-icon-box amber">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
        </div>
        <div class="metric-text-box">
          <span class="metric-value"><%= safeHackathons.length %> Contests</span>
          <span class="metric-label">Live Hackathons</span>
        </div>
      </div>
    </section>

    <!-- 2-Column Responsive Dashboard Grid -->
    <div class="dashboard-grid">

      <!-- Left / Main Column -->
      <div class="grid-column">

        <!-- Academic Operations Hub -->
        <section class="panel-card">
          <div class="panel-card-header">
            <div class="panel-title-wrap">
              <div class="panel-header-icon">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
              </div>
              <div class="panel-title-text">
                <h2>Academic Operations Suite</h2>
                <p>One-touch access to your grades, timetable, records, and career modules</p>
              </div>
            </div>
          </div>

          <div class="apps-tiles-grid">
            <!-- Profile -->
            <form action="/student-info" method="POST">
              <input type="hidden" name="id" value="<%= id %>">
              <input type="hidden" name="name" value="<%= name %>">
              <input type="hidden" name="password" value="<%= password %>">
              <button type="submit" class="app-tile">
                <div class="tile-badge-icon t-indigo">
                  <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                </div>
                <span class="tile-title">My Profile</span>
                <span class="tile-subtitle">Academic Bio</span>
              </button>
            </form>

            <!-- Attendance -->
            <form action="/student-dashboard" method="POST">
              <input type="hidden" name="id" value="<%= id %>">
              <input type="hidden" name="password" value="<%= password %>">
              <button type="submit" class="app-tile">
                <div class="tile-badge-icon t-emerald">
                  <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>
                </div>
                <span class="tile-title">Attendance</span>
                <span class="tile-subtitle">Course Logs</span>
              </button>
            </form>

            <!-- Marks & Scores -->
            <form action="/student-marks" method="POST">
              <input type="hidden" name="studentId" value="<%= id %>">
              <input type="hidden" name="password" value="<%= password %>">
              <button type="submit" class="app-tile">
                <div class="tile-badge-icon t-amber">
                  <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
                </div>
                <span class="tile-title">Marks & Grades</span>
                <span class="tile-subtitle">Reports & GPA</span>
              </button>
            </form>

            <!-- Timetable -->
            <form action="/view-timetable" method="POST">
              <input type="hidden" name="studentName" value="<%= name %>">
              <input type="hidden" name="id" value="<%= id %>">
              <input type="hidden" name="password" value="<%= password %>">
              <button type="submit" class="app-tile">
                <div class="tile-badge-icon t-purple">
                  <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                </div>
                <span class="tile-title">Timetable</span>
                <span class="tile-subtitle">Lecture Slots</span>
              </button>
            </form>

            <!-- Internships -->
            <form action="/view-internships" method="GET">
              <input type="hidden" name="name" value="<%= name %>">
              <input type="hidden" name="id" value="<%= id %>">
              <input type="hidden" name="password" value="<%= password %>">
              <button type="submit" class="app-tile">
                <div class="tile-badge-icon t-rose">
                  <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                </div>
                <span class="tile-title">Internships</span>
                <span class="tile-subtitle">Career Portal</span>
              </button>
            </form>

            <!-- SRM GPT AI -->
            <div class="app-tile" onclick="window.location.href='chat.html'">
              <div class="tile-badge-icon t-cyan" style="background: linear-gradient(135deg, #4338ca 0%, #ec4899 100%);">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <span class="tile-title">SRM GPT</span>
              <span class="tile-subtitle">Academic AI</span>
            </div>
          </div>
        </section>

        <!-- Campus Tech Gallery Showcase -->
        <section class="panel-card">
          <div class="panel-card-header">
            <div class="panel-title-wrap">
              <div class="panel-header-icon">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <div class="panel-title-text">
                <h2>Campus Spotlight & Gallery</h2>
                <p>Events, institutional achievements, and academic technology updates</p>
              </div>
            </div>
          </div>

          <div class="gallery-showcase-frame">
            <% if (safeImages && safeImages.length > 0) { %>
              <% safeImages.forEach((img, index) => { %>
                <img src="<%= img %>" class="gallery-slide <%= index === 0 ? 'active' : '' %>" alt="Campus Feature <%= index + 1 %>">
              <% }) %>
              <div class="gallery-overlay-badge">
                <span class="dot"></span>
                <span>SRM Tech Spotlight • Featured Event</span>
              </div>
            <% } else { %>
              <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;height:200px;color:var(--text-muted);">
                <svg style="width:36px;height:36px;margin-bottom:8px;opacity:0.4;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                <p>No spotlight images uploaded yet.</p>
              </div>
            <% } %>
          </div>
        </section>

        <!-- Career Opportunities Dual Section -->
        <section class="panel-card">
          <div class="panel-card-header">
            <div class="panel-title-wrap">
              <div class="panel-header-icon" style="background: rgba(244, 63, 94, 0.12); color: #fda4af; border-color: rgba(244, 63, 94, 0.25);">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              </div>
              <div class="panel-title-text">
                <h2>Featured Internship</h2>
                <p>Verified campus recruitment listings and summer trainee positions</p>
              </div>
            </div>
          </div>

          <% if (safeInternships && safeInternships.length > 0) { 
            const intern = safeInternships[0]; %>
            <div class="career-card">
              <div class="career-tags">
                <span class="career-tag-pill badge-pink"><%= intern.experience === 'experience' ? 'Experience Required' : 'Fresher / Entry Level' %></span>
                <span class="career-tag-pill badge-cyan"><%= intern.mode.charAt(0).toUpperCase() + intern.mode.slice(1) %></span>
              </div>

              <h3 class="career-title"><%= intern.title %></h3>

              <div class="career-meta">
                <div class="career-meta-item">
                  <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                  <span><%= intern.companyName %></span>
                </div>
                <div class="career-meta-item">
                  <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                  <span><%= intern.location %></span>
                </div>
              </div>

              <p class="career-desc">
                <%= intern.about.length > 180 ? intern.about.substring(0, 180) + '...' : intern.about %>
              </p>

              <div class="career-actions">
                <a href="<%= intern.link %>" target="_blank" rel="noopener noreferrer" class="btn-career-primary">
                  <span>View Details & Apply</span>
                  <svg style="width:15px;height:15px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                </a>
                
                <form action="/internship-details" method="POST" style="margin: 0;">
                  <input type="hidden" name="id" value="<%= id %>">
                  <input type="hidden" name="password" value="<%= password %>">
                  <input type="hidden" name="name" value="<%= name %>">
                  <button type="submit" class="btn-career-sub">View All (More) →</button>
                </form>
              </div>
            </div>
          <% } else { %>
            <p style="color: var(--text-muted); font-size: 0.88rem;">No internships posted currently. Check back soon!</p>
          <% } %>
        </section>

      </div>

      <!-- Right Column: Today's Schedule & Contests -->
      <div class="grid-column">

        <!-- Today's Schedule Timeline -->
        <section class="panel-card">
          <div class="panel-card-header">
            <div class="panel-title-wrap">
              <div class="panel-header-icon" style="background: rgba(14, 165, 233, 0.12); color: #7dd3fc; border-color: rgba(14, 165, 233, 0.25);">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <div class="panel-title-text">
                <h2>Today's Lectures</h2>
                <p>Period timing aligned with Day Order <%= safeDayOrder %></p>
              </div>
            </div>

            <div class="day-order-chip">
              <span class="dot"></span>
              <span><%= safeDayOrder %></span>
            </div>
          </div>

          <div class="timeline-list">
            <% 
              const fixedSlots = [
                "8:00 - 8:50", "8:50 - 9:40", "9:45 - 10:35", "10:40 - 11:30", 
                "11:35 - 12:25", "12:30 - 1:20", "1:25 - 2:15", "2:20 - 3:10", 
                "3:10 - 4:00", "4:00 - 4:50"
              ]; 
              fixedSlots.forEach(slot => {
                const subjectEntry = safeTodaySubjects.find(item => item && item.time_slot === slot);
            %>
              <div class="timeline-item">
                <div class="timeline-time">
                  <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  <span><%= slot %></span>
                </div>

                <div class="timeline-subject-badge <%= subjectEntry ? '' : 'free' %>">
                  <%= subjectEntry ? subjectEntry.subject : "Free Slot" %>
                </div>
              </div>
            <% }) %>
          </div>
        </section>

        <!-- Hackathon Highlight -->
        <section class="panel-card">
          <div class="panel-card-header">
            <div class="panel-title-wrap">
              <div class="panel-header-icon" style="background: rgba(245, 158, 11, 0.12); color: #fde68a; border-color: rgba(245, 158, 11, 0.25);">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
              </div>
              <div class="panel-title-text">
                <h2>Hackathon Arena</h2>
                <p>Team competitions & coding contests</p>
              </div>
            </div>
          </div>

          <% if (safeHackathons && safeHackathons.length > 0) { 
            const hack = safeHackathons[0]; %>
            <div class="career-card">
              <div class="career-tags">
                <span class="career-tag-pill badge-cyan"><%= hack.mode === 'Offline' ? 'In-Person / On Campus' : 'Online / Virtual' %></span>
                <span class="career-tag-pill badge-pink"><%= hack.fees === '0' ? 'Free Entry' : 'Fee: ₹' + hack.fees %></span>
              </div>

              <h3 class="career-title"><%= hack.hackathonName %></h3>

              <div class="career-meta">
                <div class="career-meta-item">
                  <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                  <span><%= hack.collegeName %></span>
                </div>
                <div class="career-meta-item">
                  <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
                  <span>Deadline: <%= hack.deadline %></span>
                </div>
              </div>

              <div class="career-actions">
                <a href="<%= hack.link %>" target="_blank" class="btn-career-primary" style="background: linear-gradient(135deg, #0284c7 0%, #38bdf8 100%);">
                  <span>Register Now</span>
                  <svg style="width:15px;height:15px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                </a>

                <form action="/hackathon-details" method="POST" style="margin: 0;">
                  <input type="hidden" name="id" value="<%= id %>">
                  <input type="hidden" name="password" value="<%= password %>">
                  <input type="hidden" name="name" value="<%= name %>">
                  <button type="submit" class="btn-career-sub">All Contests →</button>
                </form>
              </div>
            </div>
          <% } else { %>
            <p style="color: var(--text-muted); font-size: 0.88rem;">No hackathons active today.</p>
          <% } %>
        </section>

      </div>

    </div>

  </main>

