<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title><%= name %> | Student Profile & Academic Record</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    :root {
      --bg-base: #06090f;
      --bg-surface: #0c121e;
      --bg-card: rgba(15, 23, 42, 0.75);
      --bg-card-hover: rgba(24, 36, 64, 0.9);
      --border-subtle: rgba(255, 255, 255, 0.08);
      --border-glow: rgba(99, 102, 241, 0.4);
      --indigo-500: #6366f1;
      --indigo-600: #4f46e5;
      --cyan-400: #38bdf8;
      --cyan-500: #0ea5e9;
      --violet-500: #8b5cf6;
      --emerald-400: #34d399;
      --amber-400: #fbbf24;
      --rose-400: #fb7185;
      --text-main: #f8fafc;
      --text-sub: #cbd5e1;
      --text-muted: #94a3b8;
      --text-dim: #64748b;
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-full: 9999px;
      --shadow-card: 0 12px 36px -4px rgba(0, 0, 0, 0.6), 0 0 0 1px var(--border-subtle);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: var(--bg-base);
      background-image: 
        radial-gradient(ellipse 90% 60% at 50% -10%, rgba(99, 102, 241, 0.22) 0%, transparent 60%),
        radial-gradient(circle at 10% 35%, rgba(56, 189, 248, 0.12) 0%, transparent 45%),
        radial-gradient(circle at 90% 65%, rgba(139, 92, 246, 0.14) 0%, transparent 50%),
        radial-gradient(circle at 50% 100%, rgba(15, 23, 42, 0.85) 0%, transparent 80%);
      background-attachment: fixed;
      color: var(--text-main);
      min-height: 100vh;
      line-height: 1.5;
      display: flex;
      flex-direction: column;
    }

    /* Ambient Navigation Header */
    .app-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(6, 9, 15, 0.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--border-subtle);
      padding: 14px 32px;
    }

    .app-header-inner {
      max-width: 1440px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand-link {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      color: inherit;
    }

    .brand-icon-box {
      width: 38px;
      height: 38px;
      border-radius: var(--radius-sm);
      background: linear-gradient(135deg, #4f46e5 0%, #3b82f6 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      box-shadow: 0 4px 12px rgba(79, 70, 229, 0.4);
    }

    .brand-icon-box svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .brand-text-block h1 {
      font-size: 1.05rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.01em;
    }

    .brand-text-block p {
      font-size: 0.72rem;
      color: var(--text-muted);
    }

    .header-nav-right {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .verified-pill {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 6px 14px;
      border-radius: var(--radius-full);
      background: rgba(52, 211, 153, 0.12);
      border: 1px solid rgba(52, 211, 153, 0.3);
      color: var(--emerald-400);
      font-size: 0.78rem;
      font-weight: 700;
    }

    .verified-pill span.dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--emerald-400);
      box-shadow: 0 0 8px var(--emerald-400);
    }

    .btn-header-back {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 7px 16px;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .btn-header-back:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .btn-header-back svg {
      width: 15px;
      height: 15px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    /* Expansive Screen Container */
    .screen-wrapper {
      max-width: 1440px;
      width: 100%;
      margin: 0 auto;
      padding: 30px 32px 60px;
      display: flex;
      flex-direction: column;
      gap: 26px;
      flex: 1;
    }

    /* Full-Width Expansive Hero Header */
    .profile-hero-banner {
      background: linear-gradient(135deg, rgba(24, 34, 56, 0.9) 0%, rgba(15, 22, 38, 0.95) 100%);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 32px 36px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-card);
      gap: 24px;
      flex-wrap: wrap;
    }

    .profile-hero-banner::after {
      content: "";
      position: absolute;
      top: -80px;
      right: -60px;
      width: 320px;
      height: 320px;
      background: radial-gradient(circle, rgba(99, 102, 241, 0.25) 0%, transparent 70%);
      pointer-events: none;
    }

    .hero-identity-left {
      display: flex;
      align-items: center;
      gap: 24px;
      position: relative;
      z-index: 1;
    }

    .avatar-wrapper {
      position: relative;
      flex-shrink: 0;
    }

    .avatar-big {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--indigo-500) 0%, var(--cyan-400) 100%);
      padding: 3px;
      box-shadow: 0 6px 24px rgba(0, 0, 0, 0.5);
    }

    .avatar-inner {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      background: #0f172a;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.2rem;
      font-weight: 800;
      color: #ffffff;
      text-transform: uppercase;
    }

    .avatar-badge-online {
      position: absolute;
      bottom: 4px;
      right: 4px;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--emerald-400);
      border: 3px solid #0f172a;
      box-shadow: 0 0 10px var(--emerald-400);
    }

    .hero-student-names h1 {
      font-size: clamp(1.6rem, 2.6vw, 2.2rem);
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.025em;
    }

    .hero-student-meta {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: 6px;
      flex-wrap: wrap;
    }

    .meta-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 12px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 255, 255, 0.15);
      font-size: 0.8rem;
      font-weight: 700;
      color: #e2e8f0;
    }

    .hero-actions-right {
      display: flex;
      align-items: center;
      gap: 12px;
      position: relative;
      z-index: 1;
      flex-wrap: wrap;
    }

    .btn-action-primary {
      background: linear-gradient(135deg, var(--indigo-600) 0%, #3b82f6 100%);
      color: #ffffff;
      border: none;
      padding: 11px 22px;
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.86rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(79, 70, 229, 0.4);
      transition: all 0.2s ease;
    }

    .btn-action-primary:hover {
      background: linear-gradient(135deg, #4338ca 0%, #2563eb 100%);
      transform: translateY(-1px);
    }

    .btn-action-secondary {
      background: rgba(255, 255, 255, 0.06);
      border: 1px solid var(--border-subtle);
      color: var(--text-main);
      padding: 11px 20px;
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-weight: 700;
      font-size: 0.86rem;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-action-secondary:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.2);
    }

    .btn-action-primary svg,
    .btn-action-secondary svg {
      width: 17px;
      height: 17px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    /* 2-Column Full-Screen Layout */
    .profile-grid-layout {
      display: grid;
      grid-template-columns: 380px 1fr;
      gap: 26px;
      align-items: start;
    }

    @media (max-width: 1080px) {
      .profile-grid-layout {
        grid-template-columns: 1fr;
      }
    }

    .col-left, .col-right {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    /* Panel Card */
    .panel-card {
      background: var(--bg-card);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 24px 26px;
      box-shadow: var(--shadow-card);
    }

    .panel-card-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 20px;
      padding-bottom: 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }

    .panel-header-title {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .panel-header-icon {
      width: 34px;
      height: 34px;
      border-radius: var(--radius-sm);
      background: rgba(99, 102, 241, 0.12);
      border: 1px solid rgba(99, 102, 241, 0.25);
      color: var(--cyan-400);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .panel-header-icon svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .panel-header-title h2 {
      font-size: 1.05rem;
      font-weight: 700;
      color: #ffffff;
    }

    /* Digital Student Smart Card (Left Column) */
    .digital-smart-card {
      background: linear-gradient(135deg, #1e1b4b 0%, #312e81 45%, #1e40af 100%);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: var(--radius-lg);
      padding: 26px;
      position: relative;
      overflow: hidden;
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
      color: #ffffff;
    }

    .digital-smart-card::before {
      content: "";
      position: absolute;
      top: -40px;
      right: -40px;
      width: 200px;
      height: 200px;
      background: radial-gradient(circle, rgba(56, 189, 248, 0.25) 0%, transparent 65%);
      pointer-events: none;
    }

    .smart-card-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 24px;
      position: relative;
      z-index: 1;
    }

    .smart-card-institution {
      font-size: 0.82rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #cbd5e1;
    }

    .smart-card-chip {
      width: 38px;
      height: 28px;
      background: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
      border-radius: 6px;
      border: 1px solid rgba(255, 255, 255, 0.3);
      position: relative;
    }

    .smart-card-chip::after {
      content: "";
      position: absolute;
      inset: 6px;
      border: 1px solid rgba(0, 0, 0, 0.3);
      border-radius: 3px;
    }

    .smart-card-middle {
      margin-bottom: 24px;
      position: relative;
      z-index: 1;
    }

    .smart-card-roll {
      font-size: 0.74rem;
      color: #93c5fd;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .smart-card-id-num {
      font-size: 1.45rem;
      font-weight: 800;
      font-family: monospace;
      letter-spacing: 0.08em;
      color: #ffffff;
      margin-top: 2px;
    }

    .smart-card-bottom {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      position: relative;
      z-index: 1;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      padding-top: 14px;
    }

    .smart-card-field-group {
      display: flex;
      flex-direction: column;
    }

    .smart-card-field-label {
      font-size: 0.68rem;
      color: #cbd5e1;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .smart-card-field-val {
      font-size: 0.88rem;
      font-weight: 700;
      color: #ffffff;
    }

    /* Left Info Cards */
    .quick-specs-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .spec-item-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 11px 14px;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .spec-item-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    .spec-item-value {
      font-size: 0.85rem;
      color: #ffffff;
      font-weight: 700;
    }

    /* Right Column: 4 Key Metric Tiles */
    .metrics-quad-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }

    @media (max-width: 820px) {
      .metrics-quad-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .metric-quad-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 18px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: all 0.2s ease;
    }

    .metric-quad-card:hover {
      background: rgba(255, 255, 255, 0.06);
      border-color: rgba(99, 102, 241, 0.4);
      transform: translateY(-2px);
    }

    .quad-card-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .quad-icon {
      width: 36px;
      height: 36px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #ffffff;
    }

    .quad-icon.indigo { background: rgba(99, 102, 241, 0.2); color: #a5b4fc; }
    .quad-icon.cyan { background: rgba(14, 165, 233, 0.2); color: #7dd3fc; }
    .quad-icon.emerald { background: rgba(16, 185, 129, 0.2); color: #6ee7b7; }
    .quad-icon.purple { background: rgba(168, 85, 247, 0.2); color: #d8b4fe; }

    .quad-icon svg {
      width: 19px;
      height: 19px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .quad-tag {
      font-size: 0.68rem;
      font-weight: 700;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .quad-value {
      font-size: 1.15rem;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.01em;
    }

    .quad-label {
      font-size: 0.74rem;
      color: var(--text-muted);
      font-weight: 600;
    }

    /* Academic Particulars Detailed Grid */
    .credentials-detail-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }

    @media (max-width: 640px) {
      .credentials-detail-grid {
        grid-template-columns: 1fr;
      }
    }

    .detail-entry-card {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 16px 18px;
      display: flex;
      align-items: center;
      gap: 14px;
      transition: all 0.2s ease;
    }

    .detail-entry-card:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(99, 102, 241, 0.35);
    }

    .detail-icon-circle {
      width: 42px;
      height: 42px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .detail-icon-circle.indigo { background: rgba(99, 102, 241, 0.15); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.3); }
    .detail-icon-circle.cyan { background: rgba(14, 165, 233, 0.15); color: #7dd3fc; border: 1px solid rgba(14, 165, 233, 0.3); }
    .detail-icon-circle.emerald { background: rgba(16, 185, 129, 0.15); color: #6ee7b7; border: 1px solid rgba(16, 185, 129, 0.3); }
    .detail-icon-circle.amber { background: rgba(245, 158, 11, 0.15); color: #fde68a; border: 1px solid rgba(245, 158, 11, 0.3); }
    .detail-icon-circle.purple { background: rgba(168, 85, 247, 0.15); color: #d8b4fe; border: 1px solid rgba(168, 85, 247, 0.3); }
    .detail-icon-circle.rose { background: rgba(244, 63, 94, 0.15); color: #fda4af; border: 1px solid rgba(244, 63, 94, 0.3); }

    .detail-icon-circle svg {
      width: 20px;
      height: 20px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .detail-meta-text {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }

    .detail-meta-label {
      font-size: 0.72rem;
      font-weight: 700;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .detail-meta-value {
      font-size: 0.98rem;
      font-weight: 700;
      color: #ffffff;
    }

    /* Semester Progress Bar */
    .progress-box {
      margin-top: 18px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 16px 20px;
    }

    .progress-box-top {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
      font-size: 0.8rem;
    }

    .progress-bar-track {
      width: 100%;
      height: 8px;
      background: rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-full);
      overflow: hidden;
    }

    .progress-bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--indigo-500) 0%, var(--cyan-400) 100%);
      border-radius: var(--radius-full);
      width: 25%;
    }

    /* Quick Operations Hub (Bottom Grid) */
    .portal-services-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
    }

    @media (max-width: 768px) {
      .portal-services-grid {
        grid-template-columns: repeat(2, 1fr);
      }
    }

    .service-hub-btn {
      background: rgba(255, 255, 255, 0.03);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 14px;
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--text-main);
      cursor: pointer;
      font-family: inherit;
      width: 100%;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    .service-hub-btn:hover {
      background: rgba(99, 102, 241, 0.12);
      border-color: rgba(99, 102, 241, 0.4);
      transform: translateY(-2px);
    }

    .service-icon-box {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .service-icon-box svg {
      width: 18px;
      height: 18px;
      stroke: currentColor;
      fill: none;
      stroke-width: 2;
    }

    .service-text-group {
      display: flex;
      flex-direction: column;
      text-align: left;
    }

    .service-name {
      font-size: 0.84rem;
      font-weight: 700;
      color: #ffffff;
    }

    .service-sub {
      font-size: 0.7rem;
      color: var(--text-muted);
    }

    /* Print styles */
    @media print {
      body {
        background: #ffffff !important;
        color: #000000 !important;
      }
      .app-header, .hero-actions-right, .portal-services-grid {
        display: none !important;
      }
      .panel-card, .metric-quad-card, .detail-entry-card {
        background: #f8fafc !important;
        border: 1px solid #cbd5e1 !important;
        box-shadow: none !important;
      }
      .detail-meta-value, .quad-value, .smart-card-id-num {
        color: #000000 !important;
      }
    }
  </style>
</head>
<body>

  <!-- Top Ambient Header -->
  <header class="app-header">
    <div class="app-header-inner">
      <a href="/student-profile" class="brand-link">
        <div class="brand-icon-box">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 14v7"/></svg>
        </div>
        <div class="brand-text-block">
          <h1>SRM Academic Portal</h1>
          <p>Student Bio & Institutional Identity Record</p>
        </div>
      </a>

      <div class="header-nav-right">
        <div class="verified-pill">
          <span class="dot"></span>
          <span>Verified Student Profile</span>
        </div>
        <button type="button" class="btn-header-back" onclick="history.back()">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          <span>Back to Dashboard</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Full-Screen Content Canvas -->
  <main class="screen-wrapper">

    <!-- Hero Identity Banner (Full Width) -->
    <section class="profile-hero-banner">
      <div class="hero-identity-left">
        <div class="avatar-wrapper">
          <div class="avatar-big">
            <div class="avatar-inner">
              <%= (name && name.length > 0) ? name.charAt(0).toUpperCase() : 'S' %>
            </div>
          </div>
          <div class="avatar-badge-online" title="Active Student Status"></div>
        </div>

        <div class="hero-student-names">
          <h1><%= name %></h1>
          <div class="hero-student-meta">
            <span class="meta-chip">
              <svg style="width:14px;height:14px;color:var(--cyan-400);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/></svg>
              Roll ID: <%= id %>
            </span>
            <span class="meta-chip">
              <svg style="width:14px;height:14px;color:var(--emerald-400);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              Class: <%= className %>
            </span>
            <span class="meta-chip">
              <svg style="width:14px;height:14px;color:var(--violet-500);" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              Course: <%= course %>
            </span>
          </div>
        </div>
      </div>

      <div class="hero-actions-right">
        <button type="button" class="btn-action-primary" onclick="window.print()">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          <span>Print Official ID Record</span>
        </button>
        <button type="button" class="btn-action-secondary" onclick="history.back()">
          <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          <span>Return</span>
        </button>
      </div>
    </section>

    <!-- 2-Column Responsive Layout -->
    <div class="profile-grid-layout">

      <!-- Left Column: Official Digital Smart Card & Institutional Info -->
      <div class="col-left">

        <!-- Digital Smart Card Representation -->
        <div class="digital-smart-card">
          <div class="smart-card-top">
            <span class="smart-card-institution">SRM INSTITUTE • ACADEMIC SMART ID</span>
            <div class="smart-card-chip"></div>
          </div>

          <div class="smart-card-middle">
            <span class="smart-card-roll">Registration Roll Number</span>
            <div class="smart-card-id-num"><%= id %></div>
          </div>

          <div class="smart-card-bottom">
            <div class="smart-card-field-group">
              <span class="smart-card-field-label">Student Name</span>
              <span class="smart-card-field-val"><%= name %></span>
            </div>
            <div class="smart-card-field-group" style="text-align: right;">
              <span class="smart-card-field-label">Degree Track</span>
              <span class="smart-card-field-val"><%= course %></span>
            </div>
          </div>
        </div>

        <!-- Academic Institutional Status Card -->
        <section class="panel-card">
          <div class="panel-card-header">
            <div class="panel-header-title">
              <div class="panel-header-icon">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              </div>
              <h2>Academic Standing</h2>
            </div>
          </div>

          <div class="quick-specs-list">
            <div class="spec-item-row">
              <span class="spec-item-label">Enrollment Status</span>
              <span class="spec-item-value" style="color: var(--emerald-400);">● Active & Registered</span>
            </div>
            <div class="spec-item-row">
              <span class="spec-item-label">Academic Standing</span>
              <span class="spec-item-value">Good Standing</span>
            </div>
            <div class="spec-item-row">
              <span class="spec-item-label">Exam Eligibility</span>
              <span class="spec-item-value" style="color: var(--cyan-400);">Eligible</span>
            </div>
            <div class="spec-item-row">
              <span class="spec-item-label">Current Term</span>
              <span class="spec-item-value">Spring 2026</span>
            </div>
          </div>
        </section>

      </div>

      <!-- Right Column: Academic Particulars & Service Hub -->
      <div class="col-right">

        <!-- 4-Metric Highlights -->
        <section class="metrics-quad-grid">
          <div class="metric-quad-card">
            <div class="quad-card-top">
              <div class="quad-icon purple">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              </div>
              <span class="quad-tag">Program</span>
            </div>
            <span class="quad-value"><%= course %></span>
            <span class="quad-label">Enrolled Degree</span>
          </div>

          <div class="metric-quad-card">
            <div class="quad-card-top">
              <div class="quad-icon emerald">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              </div>
              <span class="quad-tag">Batch</span>
            </div>
            <span class="quad-value"><%= className %></span>
            <span class="quad-label">Class Section</span>
          </div>

          <div class="metric-quad-card">
            <div class="quad-card-top">
              <div class="quad-icon cyan">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <span class="quad-tag">Level</span>
            </div>
            <span class="quad-value">Year <%= year %></span>
            <span class="quad-label">Academic Year</span>
          </div>

          <div class="metric-quad-card">
            <div class="quad-card-top">
              <div class="quad-icon indigo">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              </div>
              <span class="quad-tag">Term</span>
            </div>
            <span class="quad-value">Sem <%= semester %></span>
            <span class="quad-label">Active Semester</span>
          </div>
        </section>

        <!-- Detailed Credentials Panel -->
        <section class="panel-card">
          <div class="panel-card-header">
            <div class="panel-header-title">
              <div class="panel-header-icon">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/></svg>
              </div>
              <h2>Enrolled Particulars & Student Bio</h2>
            </div>
          </div>

          <div class="credentials-detail-grid">
            <div class="detail-entry-card">
              <div class="detail-icon-circle indigo">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
              </div>
              <div class="detail-meta-text">
                <span class="detail-meta-label">Full Name</span>
                <span class="detail-meta-value"><%= name %></span>
              </div>
            </div>

            <div class="detail-entry-card">
              <div class="detail-icon-circle cyan">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V8a2 2 0 00-2-2h-5m-4 0V5a2 2 0 114 0v1m-4 0a2 2 0 104 0m-5 8a2 2 0 100-4 2 2 0 000 4zm0 0c1.306 0 2.417.835 2.83 2M9 14a3.001 3.001 0 00-2.83 2M15 11h3m-3 4h2"/></svg>
              </div>
              <div class="detail-meta-text">
                <span class="detail-meta-label">Registration Roll Number</span>
                <span class="detail-meta-value"><%= id %></span>
              </div>
            </div>

            <div class="detail-entry-card">
              <div class="detail-icon-circle purple">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
              </div>
              <div class="detail-meta-text">
                <span class="detail-meta-label">Degree Course</span>
                <span class="detail-meta-value"><%= course %></span>
              </div>
            </div>

            <div class="detail-entry-card">
              <div class="detail-icon-circle emerald">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
              </div>
              <div class="detail-meta-text">
                <span class="detail-meta-label">Class Section</span>
                <span class="detail-meta-value"><%= className %></span>
              </div>
            </div>

            <div class="detail-entry-card">
              <div class="detail-icon-circle amber">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              </div>
              <div class="detail-meta-text">
                <span class="detail-meta-label">Academic Year</span>
                <span class="detail-meta-value">Year <%= year %></span>
              </div>
            </div>

            <div class="detail-entry-card">
              <div class="detail-icon-circle rose">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
              </div>
              <div class="detail-meta-text">
                <span class="detail-meta-label">Active Semester</span>
                <span class="detail-meta-value">Semester <%= semester %></span>
              </div>
            </div>
          </div>

          <!-- Semester Progression Bar -->
          <div class="progress-box">
            <div class="progress-box-top">
              <span style="color: var(--text-muted); font-weight: 600;">Program Completion Trajectory</span>
              <span style="color: #ffffff; font-weight: 700;">Semester <%= semester %> Completed (Phase <%= year %>)</span>
            </div>
            <div class="progress-bar-track">
              <div class="progress-bar-fill"></div>
            </div>
          </div>
        </section>

        <!-- Quick Access Service Hub -->
        <section class="panel-card">
          <div class="panel-card-header">
            <div class="panel-header-title">
              <div class="panel-header-icon">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
              </div>
              <h2>Quick Academic Navigation</h2>
            </div>
          </div>

          <div class="portal-services-grid">
            <button type="button" class="service-hub-btn" onclick="history.back()">
              <div class="service-icon-box" style="background: rgba(99, 102, 241, 0.15); color: #a5b4fc;">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
              </div>
              <div class="service-text-group">
                <span class="service-name">Home Portal</span>
                <span class="service-sub">Dashboard View</span>
              </div>
            </button>

            <a href="chat.html" class="service-hub-btn">
              <div class="service-icon-box" style="background: rgba(14, 165, 233, 0.15); color: #7dd3fc;">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <div class="service-text-group">
                <span class="service-name">SRM GPT</span>
                <span class="service-sub">AI Study Tutor</span>
              </div>
            </a>

            <button type="button" class="service-hub-btn" onclick="window.print()">
              <div class="service-icon-box" style="background: rgba(16, 185, 129, 0.15); color: #6ee7b7;">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
              </div>
              <div class="service-text-group">
                <span class="service-name">Print Card</span>
                <span class="service-sub">Save / Export</span>
              </div>
            </button>

            <a href="/login-page" class="service-hub-btn">
              <div class="service-icon-box" style="background: rgba(244, 63, 94, 0.15); color: #fda4af;">
                <svg viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
              </div>
              <div class="service-text-group">
                <span class="service-name">Sign Out</span>
                <span class="service-sub">End Session</span>
              </div>
            </a>
          </div>
        </section>

      </div>

    </div>

  </main>

</body>
</html>
